# Copy to .env.local and fill in.

# Postgres (docker compose up -d db)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/queue_dev
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/queue_test

# Session cookie signing key: any long random string (e.g. `openssl rand -base64 48`)
SESSION_SECRET=change-me-to-a-long-random-string
